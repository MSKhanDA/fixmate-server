# Server port for local development
PORT=5000

# MongoDB (same database the Next.js client's BetterAuth uses)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=fixmate

# Must match JWT_SECRET in the client (.env.local); used to verify API tokens
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated client origins allowed by CORS; the first one is used for Stripe redirects
CLIENT_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Seed script only: the running client app that hosts BetterAuth
SEED_AUTH_URL=http://localhost:3000
